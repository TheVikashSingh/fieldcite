# Copy to .env and fill in. Never commit .env (CS-12).
# Engine API keys (server-side only).
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Kill switch (CS-8): set to false to stop all new engine calls.
SCANS_ENABLED=true

# Cited-page enrichment (SPEC M-2): contact URL in the fetcher's User-Agent.
ENRICH_CONTACT_URL=https://github.com/TheVikashSingh/fieldcite

# Database (service-role connection, server-side only).
DATABASE_URL=

# Login (F-9): at least 32 random characters, e.g. `openssl rand -base64 32`.
AUTH_SECRET=
# Public origin used in emailed links, e.g. https://fieldcite.com (defaults to http://localhost:3000 in dev).
APP_URL=

# Email through Resend. Without a key, development prints emails (with their links) to the server log.
RESEND_API_KEY=
EMAIL_FROM=
